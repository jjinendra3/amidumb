{
  "name": "amidumb",
  "version": "0.0.0",
  "private": true,
  "description": "Your AI coding transcripts, judged. Do you direct your agent or just vibecode?",
  "type": "module",
  "bin": {
    "amidumb": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^18.19.130",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
